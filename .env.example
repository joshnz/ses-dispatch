DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=<generate-a-random-50-char-string>
ALLOWED_HOSTS=dispatch.example.com
DATABASE_URL=postgis://user:password@host:5432/dispatch

# Azure Blob Storage (photo uploads)
AZURE_STORAGE_ACCOUNT_NAME=sesdispatch
AZURE_STORAGE_ACCOUNT_KEY=<key>
AZURE_CONTAINER=dispatch-photos

# Microsoft Entra ID (authentication)
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>

# Twilio SMS (optional)
TWILIO_ENABLED=true
TWILIO_SID=<sid>
TWILIO_TOKEN=<token>
TWILIO_FROM_NUMBER=+61400000000

# OpenRouteService (optional, for ETA routing)
ORS_ENABLED=true
ORS_API_KEY=<key>

# Database password (for docker-compose.prod.yml)
DB_PASSWORD=<strong-password>
